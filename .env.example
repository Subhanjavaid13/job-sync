# --- Email digest (any SMTP provider: Gmail app password, Resend SMTP, ...) ---
# Leave unset to print the digest to the console instead of sending.
EMAIL_TO=your-address@example.com
EMAIL_FROM=job-sync <alerts@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Adzuna fetcher (free keys: https://developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- JSearch fetcher (free tier: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch) ---
RAPIDAPI_KEY=

# --- Storage ---
# DB_PATH=data/jobs.db

# --- Dashboard (npm run ui) ---
# UI_PORT=4321

